<%= form_with(model: source) do |form| %>
  <% if source.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(source.errors.count, "error") %> prohibited this source from being saved:</h2>

      <ul>
        <% source.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :scenario_id, style: "display: block" %>
    <%= form.number_field :scenario_id %>
  </div>

  <div>
    <%= form.label :arrival_interval_mean, style: "display: block" %>
    <%= form.text_field :arrival_interval_mean %>
  </div>

  <div>
    <%= form.label :arrival_interval_variance, style: "display: block" %>
    <%= form.text_field :arrival_interval_variance %>
  </div>

  <div>
    <%= form.label :arrival_interval_distribution, style: "display: block" %>
    <%= form.text_field :arrival_interval_distribution %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
