<div id="<%= dom_id resource %>">
  <p>
    <strong>Scenario:</strong>
    <%= resource.scenario_id %>
  </p>

  <p>
    <strong>Resource name:</strong>
    <%= resource.resource_name %>
  </p>

  <p>
    <strong>Resource description:</strong>
    <%= resource.resource_description %>
  </p>

  <p>
    <strong>Resource capacity:</strong>
    <%= resource.resource_capacity %>
  </p>

  <p>
    <strong>Resource time mean:</strong>
    <%= resource.resource_time_mean %>
  </p>

  <p>
    <strong>Resource time variance:</strong>
    <%= resource.resource_time_variance %>
  </p>

  <p>
    <strong>Resource time distribution:</strong>
    <%= resource.resource_time_distribution %>
  </p>

</div>
