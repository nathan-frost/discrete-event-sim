<%= form_with(model: scenario) do |form| %>
  <% if scenario.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(scenario.errors.count, "error") %> prohibited this scenario from being saved:</h2>

      <ul>
        <% scenario.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.number_field :user_id %>
  </div>

  <div>
    <%= form.label :scenario_name, style: "display: block" %>
    <%= form.text_field :scenario_name %>
  </div>

  <div>
    <%= form.label :scenario_description, style: "display: block" %>
    <%= form.textarea :scenario_description %>
  </div>

  <div>
    <%= form.label :scenario_length, style: "display: block" %>
    <%= form.text_field :scenario_length %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
