<%= form_with(model: scenario, class: "needs-validation") do |form| %>
  <% if scenario.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading">
        <%= pluralize(scenario.errors.count, "error") %> prohibited this scenario from being saved:
      </h4>
      <ul>
        <% scenario.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :user_id, value: @current_user.id %>

  <div class="mb-3">
    <%= form.label :scenario_name, class: "form-label" %>
    <%= form.text_field :scenario_name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :scenario_description, class: "form-label" %>
    <%= form.text_area :scenario_description, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :scenario_length, class: "form-label" %>
    <%= form.text_field :scenario_length, class: "form-control" %>
  </div>

  <h3 class="mt-4">Arrival Generating Process</h3>
  <div class="mb-3">
    <%= form.fields_for :sources do |source_form| %>
      <%= render 'source_fields', f: source_form %>
    <% end %>
  </div>

  <h3 class="mt-4">Resources</h3>
  <div class="mb-3" data-controller="nested-form" data-nested-form-wrapper-selector-value="#resource-fields">
    <div id="resource-fields">
      <%= form.fields_for :resources do |resource_form| %>
        <%= render 'resource_fields', f: resource_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= form.fields_for :resources do |resource_form| %>
        <%= render 'resource_fields', f: resource_form %>
      <% end %>
    </template>

    <%= button_tag 'Add Resource', type: 'button', class: "btn btn-secondary", data: { action: 'nested-form#add' } %>
  </div>

  <div class="mt-4">
    <%= form.submit "Save Scenario", class: "btn btn-primary" %>
  </div>
<% end %>
