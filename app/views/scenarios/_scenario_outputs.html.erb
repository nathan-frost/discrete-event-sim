<%= turbo_frame_tag "scenario_outputs_#{scenario.id}",
  data: {
    controller: "frame-reload",
    action: "turbo:frame-load->frame-reload#reinitializeChart"
  } do %>
  
  <div
    data-controller="output"
    data-output-url-value="<%= refresh_outputs_path(scenario) %>"
    data-output-interval-value="5000">
  </div>

  <section class="mt-4">
    <h2>Simulation Summary</h2>
    <table class="table table-bordered table-striped table-sm w-auto">
      <tbody>
        <tr>
          <th scope="row">Average Wait Time</th>
          <td><%= number_with_precision(outputs.average(:wait_time), precision: 2) %></td>
        </tr>
        <tr>
          <th scope="row">Average Service Time</th>
          <td><%= number_with_precision(outputs.average(:service_time), precision: 2) %></td>
        </tr>
        <tr>
          <th scope="row">Number of Completions</th>
          <td><%= outputs.count %></td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="mt-4">
    <canvas
      data-controller="chart"
      data-chart-label-value="Wait Time by Entity"
      data-chart-labels-value="<%= raw chart_labels.to_json %>"
      data-chart-data-value="<%= raw chart_values.to_json %>"
      width="600"
      height="300">
    </canvas>
  </section>

<% end %>
