<% content_for :title, "New Scenario" %>

<div class="container mt-4">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0">New Scenario</h1>
    </div>

    <div class="card-body">
      <%= render "form", scenario: @scenario %>
