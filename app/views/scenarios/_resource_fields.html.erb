<div class="resource-fields" data-nested-form-target="field">
  <%= f.label :resource_name %>
  <%= f.text_field :resource_name %>

  <%= f.label :resource_description %>
  <%= f.text_area :resource_description %>

  <%= f.label :resource_capacity %>
  <%= f.text_field :resource_capacity %>

  <%= f.label :resource_time_mean %>
  <%= f.text_field :resource_time_mean %>

  <%= f.label :resource_time_variance %>
  <%= f.text_field :resource_time_variance %>

  <%= f.label :resource_order %>
  <%= f.number_field :resource_order %>

  <%= f.label :resource_time_distribution %>
  <%= f.select :resource_time_distribution, ['Normal', 'Exponential'] %>

  <%= f.hidden_field :_destroy, class: "destroy-flag" %>
  <%= link_to 'Remove', '#', class: 'remove-resource', data: { action: 'nested-form#remove' } %>
</div>
