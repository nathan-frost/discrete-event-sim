<div class="resource-fields mb-3 border p-3 rounded">
  <div class="row mb-2">
    <div class="col-md-4">
      <%= f.label :arrival_interval_mean, class: "form-label" %>
      <%= f.text_field :arrival_interval_mean, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= f.label :arrival_interval_variance, class: "form-label" %>
      <%= f.text_field :arrival_interval_variance, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= f.label :arrival_interval_distribution, class: "form-label" %>
      <%= f.select :arrival_interval_distribution, ['Normal', 'Exponential'], {}, class: "form-select" %>
    </div>
  </div>
</div>
